# Anthropic API key for Claude chat features
ANTHROPIC_API_KEY=sk-ant-xxxxx

# NCBI API key for PubMed searches (optional, increases rate limit)
# Get one free at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Secret key for signing proof-of-work challenges (generate a random string)
POW_HMAC_KEY=change-me-to-a-random-string

# Bcrypt salt rounds (default: 12)
BCRYPT_SALT_ROUNDS=12
